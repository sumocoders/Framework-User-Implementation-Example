{% extends '@SumoCodersFrameworkCore/user.html.twig' %}

{% block main %}
    {% if error %}
        <div class="alert alert-danger">
            {{ error.messageKey|trans(error.messageData, 'security')|raw }}
        </div>
    {% endif %}

    {% if azure_login_enabled or sumocoders_login_enabled %}
        <div class="d-grid gap-3">
        {% if azure_login_enabled %}
            <a href="{{ path('hwi_oauth_service_redirect', { service: 'azure' }) }}" class="btn btn-primary btn-lg">
                <i class="bi bi-microsoft me-2"></i>
                {{ 'Sign in with Microsoft'|trans }}
            </a>
        {% endif %}
        {% if sumocoders_login_enabled %}
            <a href="{{ path('hwi_oauth_service_redirect', { service: 'sumocoders' }) }}" class="text-muted btn btn-link">
                {{ 'Sign in with SumoCoders'|trans }}
            </a>
        {% endif %}
        </div>
    {% else %}
    {{ form_start(form) }}
    {{ form_row(form.email) }}
    <div class="form-group">
        <div class="d-flex justify-content-between">
            {{ form_label(form.password) }}
            <a href="{{ url('user_forgot_password') }}">{{ 'I forgot my password'|trans }}</a>
        </div>

        {{ form_widget(form.password) }}
        <label class="form-check form-check-label">
            <input class="form-check-input" type="checkbox" name="_remember_me" checked>
            {{ 'Keep me logged in'|trans }}
        </label>
    </div>

    <input class="btn btn-block btn-secondary mb-4" type="submit" value="{{ 'Sign in'|trans }}" />
    {{ form_end(form) }}

    <p class="align-self-center">{{ 'New to x?'|trans }} <a href="{{ url('user_register') }}">{{ 'Sign up'|trans }}</a></p>
    {% endif %}
{% endblock %}
